# Copy this file to .env.local and add your actual API keys

# Gemini API (for furniture search, suggestions, auto-design)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Claude API (for fast floor plan analysis)
# Get your API key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for floor plan vectorization with DALL-E)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

